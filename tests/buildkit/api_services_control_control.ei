pub type BuildHistoryEventType = | STARTED | COMPLETE | DELETED

pub fn build_history_event_type_num(x: BuildHistoryEventType) -> i32 {
    match x {
        STARTED => 0
        COMPLETE => 1
        DELETED => 2
    }
}

pub fn build_history_event_type_from(n: i32) -> Option[BuildHistoryEventType] {
    if n == 0 { return Some(STARTED) }
    if n == 1 { return Some(COMPLETE) }
    if n == 2 { return Some(DELETED) }
    None
}

pub const BuildHistoryEventType_STARTED: i32 = 0
pub const BuildHistoryEventType_COMPLETE: i32 = 1
pub const BuildHistoryEventType_DELETED: i32 = 2

