// The messages of BuildKit's session services (filesync, auth, secrets, sshforward, upload, exporter) and the fsutil
// types they use, generated by tools/protoc_eider.ei (tests/session/), compile; a few round trip.
import std.io
import proto
import proto.tests.session.github_com_moby_buildkit_session_filesync_filesync as fs_
import proto.tests.session.github_com_moby_buildkit_session_secrets_secrets as sec
import proto.tests.session.github_com_moby_buildkit_session_auth_auth as auth
import proto.tests.session.github_com_moby_buildkit_session_sshforward_ssh as ssh
import proto.tests.session.github_com_tonistiigi_fsutil_types_wire as wire
import std.encoding
import std.serial

fn say(s: String) uses io { io.outln(s.bytes()) }

fn main() uses io {
    let reg = sec.registry()
    let mut ann: Map[String, String] = Map.new()
    ann.insert(String.from("k"), String.from("v"))
    let b = sec.encode_get_secret_request(reg, sec.GetSecretRequest(String.from("mysecret"), ann, serial.Bytes(List.new()))).unwrap()
    say(encoding.hex(b.copy()))
    let back = sec.decode_get_secret_request(reg, b).unwrap()
    say(back.id.copy())
    let r2 = ssh.registry()
    let m = ssh.encode_bytes_message(r2, ssh.BytesMessage(serial.Bytes("hello".bytes()), serial.Bytes(List.new()))).unwrap()
    say(encoding.hex(m.copy()))
    let r3 = wire.registry()
    let p = wire.encode_packet(r3, wire.Packet(2, None, 7, serial.Bytes("xyz".bytes()), serial.Bytes(List.new()))).unwrap()
    say(encoding.hex(p.copy()))
    let pb = wire.decode_packet(r3, p).unwrap()
    say(pb.id.to_string())
}
