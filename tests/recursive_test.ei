// Recursive messages (tests/recursive/tree.proto, generated by examples/protoc/protoc_eider.ei): a message that holds itself, through a
// oneof, or through another message, is a record with a Box at the field that closes the cycle. A deep chain and a tree round trip.

import std.bytes
import std.encoding
import std.io
import std.serial
import proto
import proto.tests.recursive.tree as t

fn say(s: String) uses io { io.outln(s.bytes()) }

fn leaf(n: str) -> t.Node { t.Node(String.from(n), None, List.new(), None, None, serial.Bytes(List.new())) }

fn depth(n: t.Node) -> i32 {
    match n.next {
        Some(b) => { 1 + depth(b.get()) }
        None => 1
    }
}

fn build(n: i32) -> t.Node {
    let mut chain = leaf("end")
    for i in 0..n {
        let mut up = leaf("n")
        up.next = Some(Box.new(chain))
        chain = up
    }
    chain
}

fn main() uses io {
    let reg = t.registry()
    // a chain of 40 nodes by `next`
    let chain = build(39)
    let w = t.encode_node(reg, chain).unwrap()
    let back = t.decode_node(reg, w.copy()).unwrap()
    say(depth(back.copy()).to_string())
    say(String.from(if bytes.eq(t.encode_node(reg, back).unwrap(), w) { "chain: identical" } else { "chain: DIFFERENT" }))

    // too deep is an error (the default limit of 64 levels), not a crash
    match t.encode_node(reg, build(200)) {
        Ok(x) => { say(String.from("deep chain encoded")) }
        Err(e) => { say(String.from("deep chain refused")) }
    }

    // a tree: children, a oneof that holds a node, and the Left/Right cycle
    let mut root = leaf("root")
    root.children = List[leaf("a"), leaf("b")]
    let mut inner = leaf("inner")
    inner.body = Some(t.Number(42))
    root.body = Some(t.Inner(Box.new(inner)))
    let r = t.Right(String.from("r"), Some(Box.new(t.Left(String.from("l2"), None, serial.Bytes(List.new())))), serial.Bytes(List.new()))
    root.left = Some(t.Left(String.from("l"), Some(r), serial.Bytes(List.new())))
    let w2 = t.encode_node(reg, root).unwrap()
    say(encoding.hex(w2.copy()))
    let b2 = t.decode_node(reg, w2.copy()).unwrap()
    say(b2.children[1].name.copy())
    match b2.body {
        Some(t.Inner(x)) => {
            let n = x.get()
            match n.body {
                Some(t.Number(v)) => { say(v.to_string()) }
                _ => { say(String.from("no number")) }
            }
        }
        _ => { say(String.from("no inner")) }
    }
    say(b2.left.unwrap().right.unwrap().left.unwrap().get().tag.copy())
    say(String.from(if bytes.eq(t.encode_node(reg, b2).unwrap(), w2) { "tree: identical" } else { "tree: DIFFERENT" }))
}
